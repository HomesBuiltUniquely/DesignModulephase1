# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=DesignMod

# Google Calendar (OAuth — per-user connect in CRM UI)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/google-calendar/oauth/callback

# Google Cloud service account (server-to-server; file must NOT be committed)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/hub-interior-service-account.json

# Prolance — API token (Postman "Token" step; use hubapi, not partner emails)
PROLANCE_USERNAME=hubapi
PROLANCE_PASSWORD=
PROLANCE_API_KEY=
# Admin-only fallback partner login (designers MUST have their own entry below)
PROLANCE_PARTNER_LOGIN_ID=
PROLANCE_PARTNER_PASSWORD=
PROLANCE_PARTNER_CREDENTIALS_FILE=./credentials/prolance-partner-creds.json
# Per designer: map CRM email → Prolance LoginAPI password (LoginID = email unless overridden)
# Example: { "abhishek@hubinterior.com": "Hub28Mar", "dinesh@hubinterior.com": { "loginId": "dinesh@hubinterior.com", "password": "..." } }
# Required for /Origin/V2/Projects/Create (Hub Interior default)
PROLANCE_DEFAULT_PROJECT_TYPE=CYO

# App URLs
API_BASE_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:3000

# External projects: poll customer phones + POST /api/leads/external-intake
EXTERNAL_LEAD_INGEST_API_KEY=
# Optional alias for GET /api/customer/phones/recent only:
# CUSTOMER_NUMBERS_API_KEY=
